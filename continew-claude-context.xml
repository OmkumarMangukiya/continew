}

.inspector-error-box {
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 6px;
  padding: 12px 14px;
}

.inspector-error-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--accent-red);
  margin-bottom: 6px;
}

.inspector-error-text {
  font-family: var(--font-mono);
  font-size: 12px;
  color: #fca5a5;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.4;
}

.inspector-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 8px;
  border-top: 1px solid var(--border-subtle);
}

.inspector-trace-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--accent-blue);
  color: white;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  transition: background 0.15s ease;
}

.inspector-trace-btn:hover {
  background: var(--accent-blue-hover);
}

/* Animations */
.spin-icon {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .audit-logs-page {
    padding: 20px 16px 48px;
  }

  .audit-controls {
    flex-direction: column;
    align-items: stretch;
  }

  .audit-controls__left,
  .audit-controls__right {
    flex-direction: column;
    align-items: stretch;
  }

  .endpoint-select,
  .search-input {
    width: 100%;
    max-width: none;
  }

  .inspector-grid {
    grid-template-columns: 1fr;
  }

  .inspector-field--full {
    grid-column: span 1;
  }
}
